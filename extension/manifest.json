{
  "manifest_version": 3,
  "name": "ClassBell 课程资料下载",
  "description": "在已登录的学习通课程中选择资料，保留目录并保存到授权文件夹。",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.chaoxing.com/*", "https://*.cldisk.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 ClassBell 资料下载" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
